APP_ENV=local
PORT=3000
HOST=127.0.0.1

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:3000

# Runtime paths
APP_DATA_DIR=.data
APP_SEED_ON_BOOT=true
DATABASE_DRIVER=sqlite
DATABASE_URL=
FILE_UPLOAD_MAX_BYTES=26214400

# Authentication and session
DISABLE_MOCK_AUTH=false
ALLOW_LOCAL_PASSWORD_LOGIN=true
IDENTITY_PROVIDER_MODE=local
IDENTITY_PROVIDER_ISSUER=
IDENTITY_PROVIDER_LOGIN_URL=
SESSION_COOKIE_NAME=eproc_session
SESSION_TTL_MS=43200000
SESSION_SECRET=change-this-before-shared-uat
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
BUILD_VERSION=local-build

# CORS
# Use comma-separated origins, for example:
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
CORS_ALLOWED_ORIGINS=

# Optional upload content type override
# FILE_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png,image/webp,text/plain

# External integration adapters
# Comma-separated adapter endpoint map. Missing endpoint means local/test adapter mode.
# Supported keys: sso,oa,organizationUserSync,masterData,erp,wms,contractSystem,finance,fileService,messageNotification,auditExport,eSignature,ca,eInvoice
INTEGRATION_ENDPOINTS=
INTEGRATION_REQUEST_TIMEOUT_MS=5000
INTEGRATION_MAX_ATTEMPTS=3
REQUIRED_INTEGRATION_PROVIDERS=
# M6-B provider keys are normalized by contract key. Supported values:
# sso,oa,organizationUserSync,masterData,erp,wms,contractSystem,finance,fileService,messageNotification,auditExport,eSignature,ca,eInvoice
# Configuring an endpoint only means "contract endpoint exists"; it is not real联调 evidence until customer-system samples are attached.
# Optional per-adapter endpoint overrides:
# INTEGRATION_SSO_ENDPOINT=https://sso.example.local/api/identity
# INTEGRATION_OA_ENDPOINT=https://oa.example.local/api/eprocurement
# INTEGRATION_ERP_ENDPOINT=https://erp.example.local/api/procurement-result
# INTEGRATION_WMS_ENDPOINT=https://wms.example.local/api/order-fulfillment
# INTEGRATION_FINANCE_ENDPOINT=https://finance.example.local/api/settlement
# INTEGRATION_CONTRACT_ENDPOINT=https://contract.example.local/api/contracts
# INTEGRATION_MESSAGE_ENDPOINT=https://message.example.local/api/send
# INTEGRATION_E_SIGNATURE_ENDPOINT=https://esign.example.local/api/signature
# INTEGRATION_CA_ENDPOINT=https://ca.example.local/api/verify
# INTEGRATION_E_INVOICE_ENDPOINT=https://einvoice.example.local/api/invoice

# File storage and upload security
FILE_STORAGE_MODE=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
ANTIVIRUS_SCAN_MODE=disabled

# Web security and operations
CSRF_STRATEGY=same-site-cookie
BACKUP_DIR=output/r9-backups
R10_DRILL_DIR=output/r10-backup-restore

# Process / workflow execution boundary
# M6-A keeps R8 Workflow as the primary execution source.
# Allowed values:
#   WORKFLOW_EXECUTION_SOURCE=r8_workflow | process_layer | bpmn
#   PROCESS_LAYER_MODE=shadow | disabled | execution
#   BPMN_PILOT_MODE=shadow | disabled | production
WORKFLOW_EXECUTION_SOURCE=r8_workflow
PROCESS_LAYER_MODE=shadow
BPMN_PILOT_MODE=shadow

# Notes
# - APP_ENV supports local, test, production.
# - production mode must keep DISABLE_MOCK_AUTH=true and ALLOW_LOCAL_PASSWORD_LOGIN=false.
# - production mode must set APP_SEED_ON_BOOT=false so demo data and test accounts are not treated as production data.
# - production mode requires explicit CORS_ALLOWED_ORIGINS, SESSION_COOKIE_SECURE=true, and a non-placeholder SESSION_SECRET.
# - SQLite is only the local or small-scale UAT transitional persistence option; formal production requires a customer-approved database and DATABASE_URL.
# - FILE_STORAGE_MODE=local is not a formal production storage posture; production should use object storage or an approved shared file service after adapter cutover.
# - IDENTITY_PROVIDER_MODE=adapter/oidc/saml without a real customer provider remains a contract boundary, not a completed SSO integration.
# - INTEGRATION_ENDPOINTS and REQUIRED_INTEGRATION_PROVIDERS describe contract boundaries; configured placeholders do not prove real OA/ERP/WMS/finance/invoice/payment connectivity.
# - M6-B backup/restore drill copies local SQLite and local files for UAT evidence only. Formal production still needs customer database-native backup, object-storage restore and external-system reconciliation evidence.
# - WORKFLOW_EXECUTION_SOURCE must remain r8_workflow for M6-A. PROCESS_LAYER_MODE and BPMN_PILOT_MODE must remain shadow unless a later stage explicitly approves production cutover.
# - The following commonly keep /health.readiness.productionReady=false in production:
#   mock auth enabled, local password login enabled, APP_SEED_ON_BOOT=true, SQLite, local files, missing SSO/OA/ERP/WMS/finance/file-service endpoints, insecure cookies, empty CORS allowlist, disabled antivirus scan, BPMN production mode, or any non-R8 execution source.
