{
  "name": "e-procurement-mvp",
  "private": true,
  "version": "0.1.0",
  "description": "国企酒店集团内部阳光采购与专家评审管理平台 MVP 工程骨架",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm --workspace @eprocurement/api run dev",
    "dev:web": "npm --workspace @eprocurement/web run dev -- --host 127.0.0.1",
    "build": "npm --workspace @eprocurement/api run build && npm --workspace @eprocurement/web run build",
    "ui:tokens": "node scripts/ui-platform.mjs tokens:compile",
    "ui:dependency-map": "node scripts/ui-platform.mjs dependency-map",
    "ui:figma-sync": "node scripts/ui-platform.mjs figma:sync",
    "ui:governance": "node scripts/ui-platform.mjs governance:check",
    "ui:visual": "node scripts/ui-platform.mjs visual:regression",
    "ui:runtime": "node scripts/ui-runtime-gates.mjs",
    "ui:report": "node scripts/ui-platform.mjs report",
    "ui:platform": "npm run ui:tokens && npm run ui:figma-sync && npm run ui:dependency-map && npm run ui:governance && npm run ui:report",
    "ui:ci": "npm run ui:platform && npm run ui:scan:test && npm run ui:scan && npm run typecheck && npm run ui:runtime && npm run build",
    "ui:scan": "node scripts/ui-violation-scan.mjs",
    "ui:scan:test": "node scripts/ui-violation-scan.test.mjs",
    "ui:smoke": "node scripts/ui-page-kind-smoke.mjs",
    "ui:role-flow": "node scripts/ui-role-flow-regression.mjs",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "test": "npm --workspace @eprocurement/api run test",
    "test:api": "npm --workspace @eprocurement/api run test",
    "typecheck": "npm --workspace @eprocurement/api run typecheck && npm --workspace @eprocurement/web run typecheck",
    "r2:migrate": "node scripts/r2-sqlite-baseline.mjs",
    "r9:readiness": "node scripts/r9-production-readiness-check.mjs --backup",
    "m6b:backup-restore": "node scripts/r10-backup-restore-drill.mjs",
    "m6c:browser-smoke": "node scripts/m6c-browser-role-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
